{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "md-condesa-wa-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wa-agent-db-2",
      "database_id": "3b3d9ee3-d294-4fa5-834b-1c677984e1cb"
    },
    {
      // The OLD database (2026-10-06 "overloaded" incident), kept bound for the
      // post-switch delta copy (/admin/migrate, direction from_target). Remove
      // once the old DB is deleted.
      "binding": "DB_TARGET",
      "database_name": "wa-agent-db",
      "database_id": "c57b17de-9e0c-4a48-adc7-7cb791372cdc"
    }
  ],
  // Workers AI: Whisper transcription for inbound voice notes (src/services/media.ts).
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SLACK_CHANNEL_ID": "C0BFKQ6AU9F",
    // #evan-alerts: ONLY what needs Evan (docs/slack-routing.md, 2026-10-22).
    "SLACK_CHANNEL_ALERTS_ID": "C0C0YSLS622",
    // Retired #bot-ops: no longer posted to (mechanical notes → D1 ops_log,
    // /admin → Logs). Kept only so buttons on its old cards still update.
    "SLACK_CHANNEL_OPS_ID": "C0C76L1QPFY",
    "AIRTABLE_BASE_ID": "appcX38TBVltyxHR6",
    "AIRTABLE_TRIALS_TABLE": "Leads",
    "TRAINING_WHEELS": "1",
    "HUMAN_SNOOZE_HOURS": "8",
    "BOOKING_VIDEO_URL": "https://mdcondesa.com/media/confirmar-reserva.mp4",
    // Marketing metrics feeder (src/cron/ad-spend.ts, metrics-link.ts, metrics-brief.ts).
    "META_AD_ACCOUNT_ID": "act_1334257084455191",
    "WA_WABA_ID": "1717538906028335",
    "METRICS_SINCE": "2026-07-01",
    // Reto course login (src/pipeline/reto-login.ts): members who message
    // "…entrar a mis cursos del Reto [CURSOS]" get a login link from the site.
    // OFF until the secret RETO_BOT_SECRET is also set (same value as the
    // Pages secret on md-condesa-site).
    "RETO_LOGIN_URL": "https://mdcondesa.com/api/reto/wa-login",
    // Pre-trial questionnaire (docs/cuestionario.md): "1" = the bot sends the
    // mdcondesa.com/cuestionario/ link right after every booking confirmation.
    // Needs the secrets CUESTIONARIO_SECRET (+ CUESTIONARIO_SEND_KEY for the
    // Airtable automation). LIVE since 2026-10-15 (Evan).
    "CUESTIONARIO_ENABLED": "1"
    // Conversions API for Business Messaging (docs/meta-capi.md). Uncomment and
    // paste the dataset id linked to WA_WABA_ID once it exists in Events Manager
    // (GET /admin/api/capi/dataset reads it). Non-secret, so a var is fine. The
    // whole feature stays inert until this AND features.metaCapi are set.
    // ,"META_CAPI_DATASET_ID": "<dataset id>"
  },
  // Text modules: the compiled KB (*.md, see src/kb.ts) and the admin SPA
  // (src/ui/admin.html, imported by routes/admin-ui.ts) are inlined as strings.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md", "**/*.html"],
      "fallthrough": false
    }
  ]
}
