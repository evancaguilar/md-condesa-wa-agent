{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "md-condesa-wa-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wa-agent-db",
      "database_id": "c57b17de-9e0c-4a48-adc7-7cb791372cdc"
    }
  ],
  // Workers AI: Whisper transcription for inbound voice notes (src/services/media.ts).
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SLACK_CHANNEL_ID": "C0BFKQ6AU9F",
    "AIRTABLE_BASE_ID": "appcX38TBVltyxHR6",
    "AIRTABLE_TRIALS_TABLE": "Leads",
    "TRAINING_WHEELS": "1",
    "HUMAN_SNOOZE_HOURS": "8",
    "BOOKING_VIDEO_URL": "https://mdcondesa.com/media/confirmar-reserva.mp4",
    // Marketing metrics feeder (src/cron/ad-spend.ts, metrics-link.ts, metrics-brief.ts).
    "META_AD_ACCOUNT_ID": "act_1334257084455191",
    "WA_WABA_ID": "1717538906028335",
    "METRICS_SINCE": "2026-07-01"
    // Conversions API for Business Messaging (docs/meta-capi.md). Uncomment and
    // paste the dataset id linked to WA_WABA_ID once it exists in Events Manager
    // (GET /admin/api/capi/dataset reads it). Non-secret, so a var is fine. The
    // whole feature stays inert until this AND features.metaCapi are set.
    // ,"META_CAPI_DATASET_ID": "<dataset id>"
  },
  // Text modules: the compiled KB (*.md, see src/kb.ts) and the admin SPA
  // (src/ui/admin.html, imported by routes/admin-ui.ts) are inlined as strings.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md", "**/*.html"],
      "fallthrough": false
    }
  ]
}
